<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ADB 无线调试" Width="1000" Height="800" MinWidth="790" MinHeight="565"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="#181A1D" Foreground="#EDEFF2"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13" UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="Surface" Color="#1F2226" />
        <SolidColorBrush x:Key="Field" Color="#23262B" />
        <SolidColorBrush x:Key="Line" Color="#3A4048" />
        <SolidColorBrush x:Key="Muted" Color="#A7AFBA" />
        <SolidColorBrush x:Key="Text" Color="#EDEFF2" />
        <SolidColorBrush x:Key="Accent" Color="#9BBCEC" />
        <SolidColorBrush x:Key="Selected" Color="#2B394A" />
        <SolidColorBrush x:Key="Online" Color="#83D88A" />
        <GridLength x:Key="DeviceNameColumnWidth">1.16*</GridLength>
        <GridLength x:Key="DeviceAddressColumnWidth">*</GridLength>
        <GridLength x:Key="DeviceStateColumnWidth">100</GridLength>
        <GridLength x:Key="DeviceActionsColumnWidth">144</GridLength>
        <Orientation x:Key="DeviceActionsOrientation">Horizontal</Orientation>
        <Thickness x:Key="DeviceActionSpacing">0,0,6,0</Thickness>

        <Style x:Key="DeviceColumnHeading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0" />
        </Style>

        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="25" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="ModuleTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Feedback" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Padding" Value="0,0,0,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Background" Value="#24282D" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="MinHeight" Value="31" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Opacity" Value=".8" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Opacity" Value=".62" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource Accent}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value=".45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="#162338" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="42" />
        </Style>
        <Style x:Key="Outline" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
        </Style>
        <Style x:Key="Caption" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="45" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#343941" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Mode" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="39" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ModeFace" Background="{TemplateBinding Background}" CornerRadius="5" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ModeFace" Property="Background" Value="#303640" /></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ModeFace" Property="Background" Value="#3C4B61" />
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ModeFace" Property="BorderBrush" Value="{StaticResource Accent}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ModeFace" Property="Opacity" Value=".5" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
            <Setter Property="SelectionBrush" Value="#506C96" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="{StaticResource Field}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                <TextBlock x:Name="FieldPlaceholder" Text="{TemplateBinding Tag}" Foreground="{StaticResource Muted}"
                                           FontFamily="Microsoft YaHei UI" FontSize="12" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value=""><Setter TargetName="FieldPlaceholder" Property="Visibility" Value="Visible" /></Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Box" Property="Opacity" Value=".55" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AddressMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinWidth" Value="154" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border x:Name="MenuFrame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="4">
                            <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AddressMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="MenuRow" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="MenuRow" Property="Background" Value="{StaticResource Selected}" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="MenuRow" Property="Background" Value="{StaticResource Selected}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AddressMenuSeparator" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border x:Name="MenuRule" Height="1" Background="{StaticResource Line}" Margin="6,3" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DeviceState" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsConnected}" Value="True"><Setter Property="Foreground" Value="{StaticResource Online}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DetailsToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="DetailsFace" Background="Transparent" CornerRadius="4" Padding="0,5">
                            <DockPanel>
                                <TextBlock x:Name="DetailsArrow" DockPanel.Dock="Left" Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="10" Margin="0,0,7,0" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="DetailsArrow" Property="Text" Value="&#xE70E;" /></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource Accent}" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="{StaticResource Accent}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DeviceDetails" TargetType="Expander">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton Style="{StaticResource DetailsToggle}" Content="{TemplateBinding Header}"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                            <ContentPresenter x:Name="DetailContent" ContentSource="Content" Visibility="Collapsed" Margin="0,4,0,0" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True"><Setter TargetName="DetailContent" Property="Visibility" Value="Visible" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".5" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DeviceRowAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="Background" Value="{StaticResource Field}" />
            <Setter Property="Width" Value="56" />
            <Setter Property="MinHeight" Value="27" />
            <Setter Property="Height" Value="27" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="FontSize" Value="11" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasRowAction}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CanForgetPairing}" Value="True">
                    <Setter Property="Margin" Value="{DynamicResource DeviceActionSpacing}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DeviceRowForget" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Width" Value="70" />
            <Setter Property="MinHeight" Value="27" />
            <Setter Property="Height" Value="27" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Background" Value="{StaticResource Field}" />
            <Setter Property="BorderBrush" Value="#79544E" />
            <Setter Property="Foreground" Value="#E7A69A" />
            <Setter Property="ToolTip" Value="从本机 ADB 配对记录中移除此设备" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CanForgetPairing}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Row" Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="#30363D">
                            <ContentPresenter HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#282F38" /></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource Selected}" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Accent}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="34" /><RowDefinition Height="50" /><RowDefinition /><RowDefinition Height="Auto" MinHeight="74" /></Grid.RowDefinitions>
        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="MinimizeWindow" Content="&#xE921;" Style="{StaticResource Caption}" ToolTip="最小化" AutomationProperties.Name="最小化" />
                    <Button x:Name="MaximizeWindow" Content="&#xE922;" Style="{StaticResource Caption}" ToolTip="最大化" AutomationProperties.Name="最大化" />
                    <Button x:Name="CloseWindow" Content="&#xE8BB;" Style="{StaticResource Caption}" ToolTip="关闭" AutomationProperties.Name="关闭" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="15,0,0,0" VerticalAlignment="Center">
                    <Image x:Name="AppTitleIcon" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" />
                    <TextBlock Text="ADB 无线调试" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <DockPanel Margin="18,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="Refresh" AutomationProperties.Name="刷新" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" Margin="0,0,6,0" /><TextBlock Text="刷新" /></StackPanel>
                    </Button>
                    <Button x:Name="Diagnostics" Content="诊断" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE770;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                    <TextBlock Text="ADB 设备" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border Width="1" Height="15" Background="{StaticResource Line}" Margin="12,0" />
                    <TextBlock x:Name="ConnectionSummary" Text="正在读取设备…" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="61*" />
                <ColumnDefinition Width="39*" MinWidth="342" MaxWidth="390" />
            </Grid.ColumnDefinitions>
            <Grid Margin="15,16,13,16">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
                <StackPanel Margin="6,0,0,15">
                    <TextBlock Text="ADB 无线调试" Style="{StaticResource Heading}" FontSize="30" />
                    <TextBlock Text="Android 11+ · 配对并管理本机 ADB 无线连接" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                </StackPanel>
                <Border x:Name="DevicePanel" Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="37" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid x:Name="DeviceTableHeader" Margin="14,0" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource DeviceNameColumnWidth}" />
                                <ColumnDefinition Width="{StaticResource DeviceAddressColumnWidth}" />
                                <ColumnDefinition Width="{DynamicResource DeviceStateColumnWidth}" />
                                <ColumnDefinition Width="{DynamicResource DeviceActionsColumnWidth}" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="DeviceNameHeading" Text="设备" Style="{StaticResource DeviceColumnHeading}" Margin="30,0,6,0" />
                            <TextBlock x:Name="DeviceAddressHeading" Grid.Column="1" Text="连接地址" Style="{StaticResource DeviceColumnHeading}" />
                            <TextBlock x:Name="DeviceStateHeading" Grid.Column="2" Text="连接状态" Style="{StaticResource DeviceColumnHeading}" />
                            <TextBlock x:Name="DeviceActionsHeading" Grid.Column="3" Text="操作" Style="{StaticResource DeviceColumnHeading}" />
                        </Grid>
                        <ListView Grid.Row="1" x:Name="Devices" AutomationProperties.Name="ADB 设备列表" SelectionMode="Single"
                                  Background="Transparent" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Line}" Padding="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid x:Name="DeviceRowGrid" Margin="14,6" MinHeight="48">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{StaticResource DeviceNameColumnWidth}" />
                                            <ColumnDefinition Width="{StaticResource DeviceAddressColumnWidth}" />
                                            <ColumnDefinition Width="{DynamicResource DeviceStateColumnWidth}" />
                                            <ColumnDefinition Width="{DynamicResource DeviceActionsColumnWidth}" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Margin="6,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE8EA;" Style="{StaticResource Icon}" Foreground="{StaticResource Accent}" HorizontalAlignment="Left" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock x:Name="DeviceNameText" Text="{Binding DisplayName}" ToolTip="{Binding DisplayName}"
                                                           FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" TextAlignment="Center" />
                                                <TextBlock Text="{Binding ConnectionSummary}" Foreground="{StaticResource Muted}" FontSize="11"
                                                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock x:Name="DeviceAddressText" Grid.Column="1" Text="{Binding DisplayAddress}" ToolTip="{Binding DisplayAddressToolTip}"
                                                   Margin="6,0" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap"
                                                   TextAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock x:Name="DeviceStateText" Grid.Column="2" Text="{Binding DisplayState}" ToolTip="{Binding DisplayState}"
                                                   Style="{StaticResource DeviceState}" TextWrapping="Wrap" TextAlignment="Center"
                                                   FontSize="12" VerticalAlignment="Center" Margin="6,0" />
                                        <StackPanel x:Name="DeviceActionsPanel" Grid.Column="3" Orientation="{DynamicResource DeviceActionsOrientation}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0">
                                            <Button x:Name="DeviceActionRow" Tag="{Binding}" Style="{StaticResource DeviceRowAction}"
                                                    Content="{Binding RowActionText}" ToolTip="{Binding RowActionToolTip}"
                                                    AutomationProperties.Name="{Binding RowActionText}" />
                                            <Button x:Name="DeviceForgetRow" Tag="{Binding}" Style="{StaticResource DeviceRowForget}"
                                                    Content="解除配对" AutomationProperties.Name="解除配对" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="12,9">
                            <StackPanel DataContext="{Binding SelectedItem, ElementName=Devices}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button x:Name="CopySerial" Content="复制 ADB 标识" ToolTip="复制首选连接的标识，用于 adb -P 5038 -s"
                                                MinHeight="26" Padding="7,3" FontSize="11" />
                                    </StackPanel>
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,8,0">
                                        <Run Text="已选设备 · " /><Run Text="{Binding DisplayName, Mode=OneWay, FallbackValue=未选择}" />
                                    </TextBlock>
                                </DockPanel>
                                <Expander x:Name="DeviceDetails" Style="{StaticResource DeviceDetails}"
                                          Header="{Binding DetailsHeading, FallbackValue=设备与连接详情}" Margin="0,5,0,0">
                                    <ScrollViewer x:Name="DeviceDetailsScroll" MaxHeight="210" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel Margin="0,0,7,0">
                                            <TextBlock Text="设备序列号" Foreground="{StaticResource Muted}" FontSize="11" />
                                            <TextBox Text="{Binding HardwareSerial, Mode=OneWay}" IsReadOnly="True" Height="24" Padding="0"
                                                     Background="Transparent" BorderThickness="0" FontFamily="Consolas" FontSize="12" />
                                            <ItemsControl ItemsSource="{Binding Connections}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,7" Margin="0,4,0,0">
                                                            <StackPanel>
                                                                <DockPanel>
                                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding DisplayState}" Style="{StaticResource DeviceState}" FontSize="11" />
                                                                    <TextBlock Text="{Binding ConnectionLabel}" Foreground="{StaticResource Text}" FontWeight="SemiBold" FontSize="12" />
                                                                </DockPanel>
                                                                <TextBlock Text="{Binding DetailAddress}" Foreground="{StaticResource Muted}" FontFamily="Consolas" FontSize="12" Margin="0,4,0,0">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding DetailAddress}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBox Text="{Binding Serial, Mode=OneWay}" ToolTip="ADB 连接标识，可选中复制" IsReadOnly="True"
                                                                         TextWrapping="Wrap" Height="Auto" MinHeight="24" Padding="0"
                                                                         Background="Transparent" BorderThickness="0" FontFamily="Consolas" FontSize="11" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Expander>
                                <TextBlock x:Name="DeviceStatus" Style="{StaticResource Feedback}" Text="正在读取设备…" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
            <Border Grid.Column="1" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="PairingForm" Margin="23,17,17,16">
                        <TextBlock Text="配对新设备" Style="{StaticResource ModuleTitle}" />
                        <Border BorderBrush="{StaticResource Line}" Background="{StaticResource Surface}" BorderThickness="1" CornerRadius="6" Padding="1">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <RadioButton x:Name="QrMode" Style="{StaticResource Mode}" GroupName="PairMode" AutomationProperties.Name="二维码">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xED14;" Style="{StaticResource Icon}" Margin="0,0,7,0" /><TextBlock Text="二维码" /></StackPanel>
                                </RadioButton>
                                <RadioButton Grid.Column="1" x:Name="CodeMode" Style="{StaticResource Mode}" GroupName="PairMode" IsChecked="True" AutomationProperties.Name="配对码">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8D7;" Style="{StaticResource Icon}" Margin="0,0,7,0" /><TextBlock Text="配对码" /></StackPanel>
                                </RadioButton>
                            </Grid>
                        </Border>
                        <Grid MinHeight="300" Margin="0,13,0,0">
                            <StackPanel x:Name="CodePanel">
                                <TextBlock Text="在手机无线调试页打开「使用配对码配对设备」，保持弹窗打开。" Style="{StaticResource Hint}" Margin="0,0,0,15" />
                                <Label Content="配对地址" />
                                <ContentControl x:Name="PairAddress" Focusable="False" HorizontalContentAlignment="Stretch" />
                                <TextBlock x:Name="PairAddressHint" Text="正在查找配对地址…" Style="{StaticResource Feedback}" />
                                <Label Content="6 位配对码" Target="{Binding ElementName=PairCode}" Margin="0,13,0,0" />
                                <TextBox x:Name="PairCode" AutomationProperties.Name="六位配对码" MaxLength="6" FontFamily="Consolas" FontSize="17" />
                                <Button x:Name="SubmitPair" Content="配对" Style="{StaticResource Primary}" Margin="0,18,0,0" />
                                <TextBlock x:Name="PairStatus" Style="{StaticResource Feedback}" />
                            </StackPanel>
                            <StackPanel x:Name="QrPanel" Visibility="Collapsed">
                                <TextBlock Text="用手机的无线调试页扫码" Style="{StaticResource Hint}" TextAlignment="Center" />
                                <Border Background="White" Width="202" Height="202" CornerRadius="7" Margin="0,14,0,12" HorizontalAlignment="Center">
                                    <Grid>
                                        <TextBlock x:Name="QrPlaceholder" Text="点击下方生成二维码" Foreground="#475367" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image x:Name="QrImage" AutomationProperties.Name="无线调试配对二维码" Margin="6" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                    </Grid>
                                </Border>
                                <Button x:Name="ToggleQr" Content="生成二维码" HorizontalAlignment="Center" />
                                <TextBlock x:Name="QrStatus" Style="{StaticResource Feedback}" TextAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="-23,11,-17,0" Padding="23,14,17,0">
                            <StackPanel>
                                <TextBlock Text="连接已配对设备" Style="{StaticResource ModuleTitle}" />
                                <ContentControl x:Name="ConnectAddress" Focusable="False" HorizontalContentAlignment="Stretch"
                                                ToolTip="手机无线调试主页上的 IP 和端口" />
                                <Button x:Name="Connect" Content="连接" Style="{StaticResource Primary}" Margin="0,12,0,0" />
                                <TextBlock x:Name="ConnectStatus" Style="{StaticResource Feedback}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <Border Grid.Row="3" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <Grid Margin="20,10" VerticalAlignment="Center">
                <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,20,0">
                    <TextBlock x:Name="AdbVersion" Text="正在检测 PATH 中的 ADB…" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="AdbPath" AutomationProperties.Name="ADB 完整路径" IsReadOnly="True" Height="24"
                                 BorderThickness="0" Padding="0" Background="Transparent" Foreground="{StaticResource Muted}" FontFamily="Consolas" FontSize="12" />
                        <Button Grid.Column="1" x:Name="RedetectAdb" Content="重新检测" MinHeight="24" Padding="7,2"
                                FontSize="11" Visibility="Collapsed" Margin="8,0,0,0" />
                    </Grid>
                    <TextBlock x:Name="AdbServer" Text="独立服务 · 127.0.0.1:5038" Foreground="{StaticResource Muted}"
                               FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="DiscoveryStatus" AutomationProperties.Name="发现和配对记录状态"
                               TextAlignment="Right" TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                               FontSize="12" LineHeight="18" Text="正在检查 mDNS…" />
                    <Button x:Name="RepairAdb" Content="重启独立服务" HorizontalAlignment="Right" MinHeight="25"
                            FontSize="11" Padding="8,2" Margin="0,5,0,0" Visibility="Collapsed"
                            ToolTip="重启本工具使用的 127.0.0.1:5038 服务。本工具的无线连接会短暂中断，使用其他端口的 ADB 服务保留。" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
