<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="解除配对" Width="490" Height="334" MinWidth="490" MinHeight="334"
        MaxWidth="490" MaxHeight="334" WindowStartupLocation="CenterOwner" WindowStyle="None"
        ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13" Foreground="#EDEFF2"
        UseLayoutRounding="True" FocusManager.FocusedElement="{Binding ElementName=CancelButton}">
    <Window.Resources>
        <SolidColorBrush x:Key="DialogSurface" Color="#1F2226" />
        <SolidColorBrush x:Key="DialogField" Color="#23262B" />
        <SolidColorBrush x:Key="DialogLine" Color="#3A4048" />
        <SolidColorBrush x:Key="DialogMuted" Color="#A7AFBA" />
        <SolidColorBrush x:Key="DialogText" Color="#EDEFF2" />
        <SolidColorBrush x:Key="DialogAccent" Color="#9BBCEC" />
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource DialogText}" />
            <Setter Property="Background" Value="{StaticResource DialogField}" />
            <Setter Property="BorderBrush" Value="{StaticResource DialogLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="82" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonFace" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonFace" Property="Opacity" Value=".84" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonFace" Property="Opacity" Value=".66" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonFace" Property="BorderBrush" Value="{StaticResource DialogAccent}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonFace" Property="Opacity" Value=".45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RemoveButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Foreground" Value="#FFF7F5" />
            <Setter Property="Background" Value="#8F5A52" />
            <Setter Property="BorderBrush" Value="#A76D64" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="DialogCloseButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Width" Value="28" />
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource DialogMuted}" />
            <Setter Property="FontSize" Value="20" />
        </Style>
    </Window.Resources>
    <Border Background="{StaticResource DialogSurface}" BorderBrush="{StaticResource DialogLine}"
            BorderThickness="1" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity=".45" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
                <RowDefinition Height="62" />
            </Grid.RowDefinitions>
            <Border x:Name="DialogHeader" BorderBrush="{StaticResource DialogLine}" BorderThickness="0,0,0,1"
                    CornerRadius="12,12,0,0" Padding="20,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="30" /></Grid.ColumnDefinitions>
                    <Border Width="28" Height="28" CornerRadius="9" Background="#332F25" BorderBrush="#62533A" BorderThickness="1">
                        <TextBlock Text="!" FontSize="18" FontWeight="Bold" Foreground="#EAC674"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                    </Border>
                    <TextBlock x:Name="ConfirmationTitle" Grid.Column="1" Text="解除配对" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="2" x:Name="CloseButton" Content="×" Style="{StaticResource DialogCloseButton}"
                            VerticalAlignment="Center" />
                </Grid>
            </Border>
            <StackPanel Grid.Row="1" Margin="22,17,22,8">
                <TextBlock x:Name="ConfirmationQuestion" Text="要从这台电脑移除这部设备的配对记录吗？" FontSize="15" FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <Border Margin="0,14,0,11" Background="{StaticResource DialogField}" BorderBrush="{StaticResource DialogLine}"
                        BorderThickness="1" CornerRadius="7" Padding="12,9">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="SubjectIcon" Text="&#xE8EA;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource DialogAccent}"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="DeviceName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="DeviceGuid" Foreground="{StaticResource DialogMuted}" FontSize="11"
                                       FontFamily="Consolas" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Border>
                <TextBlock x:Name="ConfirmationNote" Text="这只会移除本机 ADB 的配对记录。手机端仍可能保留授权；要彻底撤销，请在手机「无线调试 → 已配对设备」中忘记此电脑。"
                           Foreground="{StaticResource DialogMuted}" TextWrapping="Wrap" LineHeight="19" />
            </StackPanel>
            <Border Grid.Row="2" BorderBrush="{StaticResource DialogLine}" BorderThickness="0,1,0,0" Padding="18,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="CancelButton" Content="取消" Style="{StaticResource DialogButton}"
                            IsCancel="True" IsDefault="True" Margin="0,0,8,0" />
                    <Button x:Name="ConfirmButton" Content="解除配对" Style="{StaticResource RemoveButton}" MinWidth="96" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
