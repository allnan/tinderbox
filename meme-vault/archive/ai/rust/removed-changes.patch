-            .unwrap_or(0.5)
-            .clamp(0.0, 1.0);
-        entries.push(DraftEntry {
-            item_id: id,
-            action,
-            reason: clean_text(row.get("reason").and_then(Value::as_str).unwrap_or(""), 60),
-            confidence,
-            source: "ai".to_string(),
-        });
-    }
