{
  "name": "x-media-studio-tauri",
  "private": true,
  "version": "1.0.0",
  "description": "X 媒体工坊 Tauri 真实功能版：Rust 桌面后端 + React 界面，解析 X 推文、保存媒体、导出 GIF/WebP",
  "type": "module",
  "scripts": {
    "prepare:dist": "node scripts/prepare-dist.mjs",
    "dev": "npm run prepare:dist && tauri dev",
    "build": "npm run prepare:dist && tauri build --no-bundle && node scripts/copy-release.mjs",
    "build:bundle": "npm run prepare:dist && tauri build && node scripts/copy-release.mjs",
    "capture": "node scripts/capture-screenshots.mjs",
    "generate:assets": "python scripts/generate-assets.py",
    "tauri": "tauri",
    "build:frontend": "node scripts/build.mjs",
    "typecheck": "node scripts/typecheck.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@rollup/plugin-commonjs": "^28.0.1",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "rollup": "^4.52.0",
    "terser": "^5.51.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
