{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XMediaStudioTauri",
  "version": "1.0.0",
  "identifier": "com.xmediastudio.tauri.preview",
  "build": {
    "beforeDevCommand": "node scripts/prepare-dist.mjs",
    "beforeBuildCommand": "node scripts/prepare-dist.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "X 媒体工坊",
        "width": 1320,
        "height": 840,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "decorations": false,
        "center": true,
        "shadow": true,
        "visible": true,
        "focus": true,
        "backgroundColor": "#0a0d13",
        "create": false
      }
    ],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": false,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    },
    "withGlobalTauri": false,
    "appDirectoriesOverride": "./userdata"
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
